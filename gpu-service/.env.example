# Required
API_KEY=change-me-to-a-strong-random-secret

# TTS defaults (optional — these match the upstream script defaults)
TTS_SILENCE=1.5
TTS_SAMPLE_RATE=22050
TTS_MIN_CHARS=500
TTS_MAX_CHARS=500
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Storage paths (defaults match Docker volume mounts)
JOBS_DIR=/data/jobs
VOICE_SAMPLES_DIR=/data/voice-samples
